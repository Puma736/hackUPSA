                  <button
                    type="button"
                    onClick={() => setShowAdminForm(false)}
                    className="p-1.5 rounded-full hover:bg-[#121c17] text-stone-400 hover:text-stone-200 cursor-pointer transition-colors"
                  >
                    <X className="w-5 h-5" />
                  </button>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-12 gap-6">
                  {/* General details */}
                  <div className="md:col-span-6 space-y-4">
                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Nombre Comercial / Local *</label>
                      <input
                        type="text"
                        required
                        placeholder="Ej. Almendra Chiquitana, Totaí, Copaibo"
                        value={formName}
                        onChange={(e) => setFormName(e.target.value)}
