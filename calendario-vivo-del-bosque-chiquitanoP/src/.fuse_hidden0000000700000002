                    </div>

                    <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-1">
                        <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Municipio de Origen principal</label>
                        <select
                          value={formTown}
                          onChange={(e) => setFormTown(e.target.value)}
                          className="w-full p-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-200 focus:border-emerald-700"
                        >
                          <option value="Concepción">Concepción</option>
                          <option value="San Ignacio de Velasco">San Ignacio de Velasco</option>
                          <option value="Lomerío">Lomerío</option>
                          <option value="San José de Chiquitos">San Jose de Chiquitos</option>
                          <option value="Roboré">Roboré</option>
                          <option value="Santiago de Chiquitos">Santiago de Chiquitos</option>
                        </select>
                      </div>

                      <div className="space-y-1">
                        <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Usos Gastronómicos (una por línea)</label>
                        <textarea
                          rows={2.5}
                          placeholder="Ej: Ideal para pestos chiquitanos...&#10;Aceite para marinado de carnes nativas..."
                          value={formUses}
                          onChange={(e) => setFormUses(e.target.value)}
                          className="w-full p-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-200 focus:border-emerald-700 focus:outline-none"
                        />
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-1">
                        <label className="text-[10px] font-mono text-slate-500 uppercase block">Posición X en mapa (%)</label>
                        <input
                          type="number"
                          min="10"
                          max="90"
                          value={formLat}
                          onChange={(e) => setFormLat(parseInt(e.target.value))}
                          className="w-full p-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-200 focus:border-emerald-700 focus:outline-none"
                        />
                      </div>
                      <div className="space-y-1">
                        <label className="text-[10px] font-mono text-slate-500 uppercase block">Posición Y en mapa (%)</label>
                        <input
                          type="number"
                          min="10"
                          max="90"
                          value={formLng}
                          onChange={(e) => setFormLng(parseInt(e.target.value))}
                          className="w-full p-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-200 focus:border-emerald-700 focus:outline-none"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                {/* Sub-form section: Contacts addition */}
                <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4">
                  <h5 className="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Acopios & Contactos autorizados para el producto</h5>

                  {/* Current Contacts List inside form */}
                  {formContacts.length > 0 && (
                    <div className="grid grid-cols-2 gap-3 mb-4">
                      {formContacts.map(c => (
                        <div key={c.id} className="p-2 px-3 bg-slate-950 rounded-lg text-xs flex justify-between items-center border border-slate-850">
                          <div>
                            <span className="font-bold text-slate-100">{c.name}</span>
                            <span className="text-[9.5px] text-slate-400 block">{c.type} • {c.phone}</span>
                          </div>
                          <button
                            type="button"
                            onClick={() => handleRemoveContact(c.id)}
                            className="text-red-400 text-xs p-1 hover:bg-slate-900 rounded"
                          >
                            Remover
                          </button>
                        </div>
                      ))}
                    </div>
                  )}

                  <div className="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
                    <div className="space-y-1">
                      <input
                        type="text"
                        placeholder="Nombre comercial/asociación"
                        value={newContactName}
                        onChange={(e) => setNewContactName(e.target.value)}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      />
                    </div>
                    <div className="space-y-1">
                      <input
                        type="text"
                        placeholder="Rol (ej: Acopio mayorista)"
                        value={newContactRole}
                        onChange={(e) => setNewContactRole(e.target.value)}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      />
                    </div>
                    <div className="space-y-1">
                      <select
                        value={newContactType}
                        onChange={(e) => setNewContactType(e.target.value as Contact["type"])}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      >
                        <option value="Asociación">Asociación</option>
                        <option value="Productor">Productor</option>
                        <option value="Tienda">Tienda</option>
                        <option value="Proveedor">Proveedor</option>
                      </select>
                    </div>
                    <div className="space-y-1">
                      <input
                        type="text"
                        placeholder="Teléfono/WhatsApp (+591)"
                        value={newContactPhone}
                        onChange={(e) => setNewContactPhone(e.target.value)}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      />
                    </div>
                    <button
                      type="button"
                      onClick={handleAddContact}
                      className="bg-slate-800 hover:bg-slate-700 text-[#d4af37] text-xs font-bold py-2 px-3 rounded-lg cursor-pointer"
                    >
                      Añadir Contacto
                    </button>
                  </div>
                </div>

                {/* Sub-form section: Recipes addition */}
                <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-4">
                  <h5 className="text-xs font-bold text-[#d4af37] uppercase tracking-wider">Recetas "Del Bosque Chiquitano a la Mesa"</h5>

                  {formRecipes.length > 0 && (
                    <div className="space-y-2 mb-4">
                      {formRecipes.map(r => (
                        <div key={r.id} className="p-2.5 bg-slate-950 rounded-lg text-xs flex justify-between items-center border border-slate-850">
                          <div>
                            <span className="font-bold text-slate-100">{r.title}</span>
                            <span className="text-[10px] text-slate-400 block">{r.difficulty} • {r.servings}</span>
                          </div>
                          <button
                            type="button"
                            onClick={() => handleRemoveRecipe(r.id)}
                            className="text-red-400 text-xs p-1 hover:bg-slate-900 rounded"
                          >
                            Remover Receta
                          </button>
                        </div>
                      ))}
                    </div>
                  )}

                  <div className="space-y-3">
                    <div className="grid grid-cols-3 gap-3">
                      <input
                        type="text"
                        placeholder="Título de la receta..."
                        value={newRecipeTitle}
                        onChange={(e) => setNewRecipeTitle(e.target.value)}
                        className="col-span-2 w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      />
                      <select
                        value={newRecipeDifficulty}
                        onChange={(e) => setNewRecipeDifficulty(e.target.value as Recipe["difficulty"])}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                      >
                        <option value="Fácil">Fácil</option>
                        <option value="Medio">Medio</option>
                        <option value="Avanzado">Avanzado</option>
                      </select>
                    </div>

                    <textarea
                      rows={1.5}
                      placeholder="Breve descripción del concepto o historia de la receta..."
                      value={newRecipeDesc}
                      onChange={(e) => setNewRecipeDesc(e.target.value)}
                      className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs"
                    />

                    <div className="grid grid-cols-2 gap-3">
                      <textarea
                        rows={2.5}
                        placeholder="Ingredientes (uno por línea)..."
                        value={newRecipeIngredients}
                        onChange={(e) => setNewRecipeIngredients(e.target.value)}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs font-mono"
                      />
                      <textarea
                        rows={2.5}
                        placeholder="Pasos/Instrucciones de preparación (uno por línea)..."
                        value={newRecipeInstructions}
                        onChange={(e) => setNewRecipeInstructions(e.target.value)}
                        className="w-full p-2 bg-slate-950 border border-slate-800 rounded-lg text-xs font-mono"
                      />
                    </div>

                    <div className="flex justify-between items-center bg-slate-950 p-2.5 rounded-lg">
                      <div className="flex items-center gap-2">
                        <span className="text-[10px] text-slate-400 uppercase font-bold">Porciones:</span>
                        <input
                          type="text"
                          value={newRecipeServings}
                          onChange={(e) => setNewRecipeServings(e.target.value)}
                          className="p-1 px-2 bg-slate-900 border border-slate-800 rounded text-xs w-28 text-slate-100"
                        />
                      </div>
                      <button
                        type="button"
                        onClick={handleAddRecipe}
                        className="bg-slate-800 hover:bg-slate-700 text-[#d4af37] text-xs font-bold py-2 px-4 rounded-lg cursor-pointer"
                      >
                        Añadir Receta a Ficha
                      </button>
                    </div>
                  </div>
                </div>

                <div className="pt-4 border-t border-slate-900 flex justify-end gap-3">
                  <button
                    type="button"
                    onClick={() => {
                      setShowAdminForm(false);
                      setEditingProduct(null);
                    }}
                    className="p-3 bg-slate-900 hover:bg-slate-850 text-slate-400 text-xs font-bold rounded-xl cursor-pointer"
                  >
                    Descartar Registro
                  </button>
                  <button
                    type="submit"
                    className="p-3 bg-emerald-600 hover:bg-emerald-500 text-slate-950 text-xs font-black rounded-xl cursor-pointer"
                  >
                    {editingProduct ? "Guardar Cambios de Ficha" : "Registrar Especie Autorizada"}
                  </button>
                </div>
              </form>
            )}

            {/* List of current editable Products */}
            <div className="space-y-3">
              <h4 className="text-xs font-bold text-slate-400 uppercase tracking-widest">Listado general de edición</h4>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {products.map(prod => (
                  <div key={prod.id} className="p-4 bg-slate-950 rounded-2xl border border-slate-800 flex justify-between items-start gap-4 hover:border-slate-700 transition-all">
                    <div>
                      <h5 className="font-extrabold text-sm text-slate-200">{prod.name}</h5>
                      <span className="text-[10px] font-serif italic text-slate-500 block">{prod.scientificName}</span>
                      <span className="inline-block mt-2 text-[10px] bg-slate-900 text-emerald-400 px-2 py-0.5 rounded border border-slate-800">
                        {prod.category}
                      </span>
                    </div>

                    <div className="flex flex-col gap-2 shrink-0">
                      <button
                        type="button"
                        onClick={() => {
                          handleOpenEditForm(prod);
                          // scroll to form
                          window.scrollTo({ top: 300, behavior: 'smooth' });
                        }}
                        className="p-2 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-xs font-bold text-slate-200 border border-slate-800 flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <Edit2 className="w-3.5 h-3.5" /> Editar
                      </button>
                      <button
                        type="button"
                        id={`btn-del-${prod.id}`}
                        onClick={() => handleDeleteProduct(prod.id)}
                        className="p-2 py-1.5 rounded-lg bg-red-950/20 hover:bg-red-900/40 text-xs font-bold text-red-400 border border-red-900/30 flex items-center justify-center gap-1 cursor-pointer"
                      >
                        <Trash2 className="w-3.5 h-3.5" /> Borrar
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        )}

      </main>

      {/* Main Footer */}
      <footer className="bg-[#070b09] mt-16 border-t border-emerald-950/40 py-12 text-stone-400">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">

          {/* Col 1: FAN Brand description */}
          <div className="space-y-3">
            <div className="flex items-center gap-2.5">
              <LogoMark className="h-11 w-auto" />
            </div>
            <p className="text-xs text-stone-400 leading-relaxed max-w-xs font-serif">
              La Fundación Amigos de la Naturaleza (FAN) es una institución boliviana sin fines de lucro enfocada en la conservación de la biodiversidad y el desarrollo sustentable en estrecha colaboración con las comunidades originarias de la Chiquitania.
            </p>
          </div>

          {/* Col 2: Inpact message */}
          <div className="space-y-2">
            <h5 className="font-bold text-[10px] uppercase tracking-wider text-[#c5a059] font-mono">Sobre el Biocalendario</h5>
            <p className="text-xs text-stone-400 leading-relaxed font-serif">
              Consumir productos forestales no-maderables genera ingresos vitales que ayudan a las familias rurales a prevenir incendios descontrolados, proteger el sotobosque primario y mitigar el avance de la deforestación agrícola en Santa Cruz.
            </p>
          </div>

          {/* Col 3: Bio Sostenibilidad pact */}
          <div className="bg-[#0b120f] p-4.5 rounded-2xl border border-emerald-950/30 space-y-2 text-center md:text-left">
            <p className="text-[10px] uppercase font-black tracking-widest text-[#c5a059] font-mono">Pacto de Sostenibilidad</p>
            <p className="text-xs text-stone-100 font-bold">Uso y Consumo Responsable</p>
            <p className="text-[11px] text-stone-400 leading-relaxed font-serif">
              Los alimentos del bosque chiquitano preservados en este calendario estacional provienen de áreas de manejo forestal comunitario certificado, promoviendo cosechas amigables con los ciclos ecosistemas bolivianos.
            </p>
          </div>

        </div>

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-emerald-955/10 mt-10 pt-5 text-center text-[10px] text-stone-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <span>© 2026 Fundación Amigos de la Naturaleza. Todos los derechos reservados. Santa Cruz, Bolivia.</span>
          <span className="flex items-center justify-center gap-1.5 font-sans hover:text-stone-400 transition-colors">
            Conectando a Productores de la Chiquitania y Cocinas Sostenibles de Bolivia <Heart className="w-3.5 h-3.5 text-stone-600 fill-current" />
          </span>
        </div>
      </footer>

    </div>
  );
}

// Compact helper icon because standard lucide doesn't have custom high-detail leaves
