                </p>
              </div>

              <div className="flex items-center gap-2 shrink-0">
                <button
                  id="btn-admin-add"
                  onClick={handleOpenAddForm}
                  className="bg-[#c5a059] hover:bg-[#d9b773] text-[#070b09] font-bold px-4 py-2.5 rounded-xl text-xs flex items-center gap-1.5 cursor-pointer shadow transition-all"
                >
                  <Plus className="w-4 h-4 text-[#070b09] stroke-2" /> Agregar Especie Silvestre
                </button>
                <button
                  id="btn-admin-exit"
                  onClick={() => {
                    setActiveTab("catalog");
                  }}
                  className="bg-[#121c17] hover:bg-[#192b21] hover:text-stone-100 text-[#40c38e] border border-emerald-900/30 px-4 py-2.5 rounded-xl text-xs font-semibold cursor-pointer transition-colors"
                >
                  Volver al Catálogo
                </button>
              </div>
            </div>

            {/* Admin Add/Edit Form Overlay */}
