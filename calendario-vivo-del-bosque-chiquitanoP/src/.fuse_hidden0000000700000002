import React, { useState, useEffect } from "react";
import {
  Calendar,
  Search,
  Filter,
  MapPin,
  User,
  Mail,
  Phone,
  Plus,
  Edit2,
  Trash2,
  Sparkles,
  ChefHat,
  BookOpen,
  Bell,
  ArrowRight,
  X,
  CheckCircle2,
  Globe,
  SlidersHorizontal,
  Lock,
  Heart,
  Share2,
  ChevronRight,
  Info,
  Check,
  Smartphone,
  Home
} from "lucide-react";
import { Product, Contact, Recipe, ProductStatus, SystemAlert, Subscriber } from "./types";
import { INITIAL_PRODUCTS, MONTH_NAMES, CATEGORIES } from "./data";
import InteractiveMap from "./components/InteractiveMap";
import AiChef from "./components/AiChef";
import Logo, { LogoMark } from "./components/Logo";


export default function App() {
  // Database State with localStorage support
  const [products, setProducts] = useState<Product[]>([]);
  const [selectedProduct, setSelectedProduct] = useState<Product | null>(null);

  // Simulated Time (Month 1-12). Default to May (5) as per current metadata May 2026
  const [simulatedMonth, setSimulatedMonth] = useState<number>(5);

  // Search & Filters
  const [searchTerm, setSearchTerm] = useState<string>("");
  const [selectedCategory, setSelectedCategory] = useState<string>("Todos");
  const [selectedStatusFilter, setSelectedStatusFilter] = useState<string>("Todos");

  // Mode View tabs: "home" | "catalog" | "map" | "chef" | "admin"
  const [activeTab, setActiveTab] = useState<"home" | "catalog" | "map" | "chef" | "admin">("home");

  // Home slide index (products list)
  const [homeSlideIndex, setHomeSlideIndex] = useState<number>(0);
  // Modal for displaying recipe details
  const [selectedHomeRecipe, setSelectedHomeRecipe] = useState<any | null>(null);

  // Subscriber Form
  const [subscriberName, setSubscriberName] = useState<string>("");
  const [subscriberEmail, setSubscriberEmail] = useState<string>("");
  const [subscriberPhone, setSubscriberPhone] = useState<string>("");
  const [subChannels, setSubChannels] = useState<("email" | "whatsapp")[]>(["email"]);
  const [subTerms, setSubTerms] = useState<boolean>(false);
  const [subStatus, setSubStatus] = useState<"idle" | "success">("idle");
  const [lastSub, setLastSub] = useState<Subscriber | null>(null);

  // Auth (simulated, persisted in localStorage)
  const [authUser, setAuthUser] = useState<{ name: string; email: string } | null>(null);
  const [showAuthModal, setShowAuthModal] = useState<boolean>(false);
  const [authMode, setAuthMode] = useState<"login" | "register">("login");
  const [authName, setAuthName] = useState<string>("");
  const [authEmail, setAuthEmail] = useState<string>("");
  const [authPassword, setAuthPassword] = useState<string>("");
  const [authError, setAuthError] = useState<string>("");

  // Admin Panel State
  const [isAdminMode, setIsAdminMode] = useState<boolean>(false);
  const [editingProduct, setEditingProduct] = useState<Product | null>(null);
  const [showAdminForm, setShowAdminForm] = useState<boolean>(false);

  // Form Fields for Add/Edit Product
  const [formName, setFormName] = useState<string>("");
  const [formScientificName, setFormScientificName] = useState<string>("");
  const [formDescription, setFormDescription] = useState<string>("");
  const [formCategory, setFormCategory] = useState<Product["category"]>("Semilla/Nuez");
  const [formCharacteristics, setFormCharacteristics] = useState<string>("");
  const [formSeasonMonths, setFormSeasonMonths] = useState<number[]>([]);
  const [formUses, setFormUses] = useState<string>("");
  const [formTown, setFormTown] = useState<string>("Concepción");
  const [formLat, setFormLat] = useState<number>(40);
  const [formLng, setFormLng] = useState<number>(50);

  // Nested form creation state
  const [formContacts, setFormContacts] = useState<Contact[]>([]);
  const [newContactName, setNewContactName] = useState<string>("");
  const [newContactRole, setNewContactRole] = useState<string>("");
  const [newContactType, setNewContactType] = useState<Contact["type"]>("Asociación");
  const [newContactPhone, setNewContactPhone] = useState<string>("");
  const [newContactLocation, setNewContactLocation] = useState<string>("");

  const [formRecipes, setFormRecipes] = useState<Recipe[]>([]);
  const [newRecipeTitle, setNewRecipeTitle] = useState<string>("");
  const [newRecipeDesc, setNewRecipeDesc] = useState<string>("");
  const [newRecipeIngredients, setNewRecipeIngredients] = useState<string>("");
  const [newRecipeInstructions, setNewRecipeInstructions] = useState<string>("");
  const [newRecipeServings, setNewRecipeServings] = useState<string>("4 porciones");
  const [newRecipeDifficulty, setNewRecipeDifficulty] = useState<Recipe["difficulty"]>("Fácil");

  // Load from LocalStorage
  useEffect(() => {
    const savedProducts = localStorage.getItem("fan_chiquitano_products");
    if (savedProducts) {
      try {
        setProducts(JSON.parse(savedProducts));
      } catch (e) {
        setProducts(INITIAL_PRODUCTS);
      }
    } else {
      setProducts(INITIAL_PRODUCTS);
      localStorage.setItem("fan_chiquitano_products", JSON.stringify(INITIAL_PRODUCTS));
    }
  }, []);

  // Sync to LocalStorage
  const saveProductsList = (updatedList: Product[]) => {
    setProducts(updatedList);
    localStorage.setItem("fan_chiquitano_products", JSON.stringify(updatedList));
  };

  // Status calculation for a product at simulatedMonth
  const getProductStatus = (product: Product, month: number): ProductStatus => {
    const isCurrentIn = product.seasonMonths.includes(month);
    const nextMonth = month === 12 ? 1 : month + 1;
    const isNextIn = product.seasonMonths.includes(nextMonth);

    if (isCurrentIn) {
      return !isNextIn ? "Termina Pronto" : "En Temporada";
    } else {
      return isNextIn ? "Comienza Pronto" : "Fuera de Temporada";
    }
  };

  // Filtered Products List
  const filteredProducts = products.filter((prod) => {
    // Search terms
    const matchesSearch =
      prod.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      prod.scientificName.toLowerCase().includes(searchTerm.toLowerCase()) ||
      prod.description.toLowerCase().includes(searchTerm.toLowerCase()) ||
      prod.gastronomicUses.some((use) => use.toLowerCase().includes(searchTerm.toLowerCase()));

    // Category
    const matchesCategory = selectedCategory === "Todos" || prod.category === selectedCategory;

    // Status
    const status = getProductStatus(prod, simulatedMonth);
    const matchesStatus = selectedStatusFilter === "Todos" || status === selectedStatusFilter;

    return matchesSearch && matchesCategory && matchesStatus;
  });

  // Calculate high-priority notifications for the current simulated month
  const currentAlerts: SystemAlert[] = products
    .map((prod) => {
      const status = getProductStatus(prod, simulatedMonth);
      let msg = "";
      let type: "start" | "end" | "soon" = "soon";

      if (status === "En Temporada" && prod.seasonMonths.indexOf(simulatedMonth) === 0) {
        msg = `¡La temporada de ${prod.name} acaba de iniciar oficialmente! Ya puedes contactar a las asociaciones de recolectores locales para la provisión fresca del mes.`;
        type = "start";
      } else if (status === "Termina Pronto") {
        msg = `⚠️ Último mes de disponibilidad de ${prod.name}. Ideal para deshidratados, congelados, pulpas y conservas para restaurantes antes de la veda silvestre.`;
        type = "end";
      } else if (status === "Comienza Pronto") {
        msg = `🌿 Se acerca la temporada de ${prod.name}. Programa tus reservas gastronómicas y planifica lanzamientos de menú con el próximo fruto del bosque.`;
        type = "soon";
      }

      if (msg) {
        return {
          id: `${prod.id}-${simulatedMonth}`,
          productId: prod.id,
          productName: prod.name,
          type,
          message: msg,
          date: `Validez: ${MONTH_NAMES[simulatedMonth - 1]}`
        };
      }
      return null;
    })
    .filter(Boolean) as SystemAlert[];

  // Set first product as default selected if none in list
  useEffect(() => {
    if (filteredProducts.length > 0 && !selectedProduct) {
      setSelectedProduct(filteredProducts[0]);
    }
  }, [filteredProducts, selectedProduct]);

  // Handle subscriber submit
  const handleSubscribe = (e: React.FormEvent) => {
    e.preventDefault();
    if (!subscriberEmail && !subscriberPhone) return;
    if (!subTerms) return; // must accept terms

    const newSub: Subscriber = {
      name: subscriberName || authUser?.name || "",
      email: subscriberEmail,
      phone: subscriberPhone,
      channels: subChannels,
      interestedCategories: [selectedCategory !== "Todos" ? selectedCategory : "General"],
      interestedProductId: selectedProduct?.id,
      acceptedTerms: true,
      createdAt: new Date().toISOString()
    };

    const existing = localStorage.getItem("fan_subscribers");
    let arr: Subscriber[] = [];
    if (existing) {
      try { arr = JSON.parse(existing); } catch (err) { }
    }
    arr.push(newSub);
    localStorage.setItem("fan_subscribers", JSON.stringify(arr));

    setLastSub(newSub);
    setSubStatus("success");
  };

  // Build a dedicated harvest-alert message for a product
  const buildAlertMessage = (sub: Subscriber | null) => {
    const prod = selectedProduct;
    const who = sub?.name || authUser?.name || "un interesado";
    const months = prod ? prod.seasonMonths.map(m => MONTH_NAMES[m - 1]).join(", ") : "la temporada";
    const prodName = prod ? prod.name : "los productos del bosque chiquitano";
    return (
      `Hola, soy ${who}. Acepto recibir avisos sobre las fechas de ALTA COSECHA de ${prodName} ` +
      `(meses: ${months}). Por favor contáctenme cuando inicie la temporada. ` +
      `Mi correo: ${sub?.email || "(sin correo)"} | WhatsApp: ${sub?.phone || "(sin número)"}.`
    );
  };

  // Recipient: the gatherer/association contact of the selected product ("a quién pasarle la info")
  const getAlertRecipient = (): Contact | null => {
    if (selectedProduct && selectedProduct.contacts.length > 0) return selectedProduct.contacts[0];
    return null;
  };

  const buildWhatsappLink = (sub: Subscriber | null) => {
    const recipient = getAlertRecipient();
    const phone = (recipient?.phone || "").replace(/[^0-9]/g, "");
    const text = encodeURIComponent(buildAlertMessage(sub));
    return phone ? `https://wa.me/${phone}?text=${text}` : `https://wa.me/?text=${text}`;
  };

  const buildMailtoLink = (sub: Subscriber | null) => {
    const subject = encodeURIComponent(`Alerta de alta cosecha — ${selectedProduct?.name || "Bosque Chiquitano"}`);
    const body = encodeURIComponent(buildAlertMessage(sub));
    return `mailto:?subject=${subject}&body=${body}`;
  };

  const resetSubscribeForm = () => {
    setSubStatus("idle");
    setSubscriberName("");
    setSubscriberEmail("");
    setSubscriberPhone("");
    setSubTerms(false);
    setLastSub(null);
  };

  // Load persisted auth user on mount
  useEffect(() => {
    const u = localStorage.getItem("fan_auth_user");
    if (u) {
      try {
        const parsed = JSON.parse(u);
        setAuthUser(parsed);
        if (parsed?.name) setSubscriberName(parsed.name);
        if (parsed?.email) setSubscriberEmail(parsed.email);
      } catch (err) { }
    }
  }, []);

  // Simulated auth handlers (localStorage-based)
  const handleAuthSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setAuthError("");
    const usersRaw = localStorage.getItem("fan_users");
    let users: { name: string; email: string; password: string }[] = [];
    if (usersRaw) { try { users = JSON.parse(usersRaw); } catch (err) { } }

    if (authMode === "register") {
      if (!authName || !authEmail || !authPassword) { setAuthError("Completa todos los campos."); return; }
      if (users.some(u => u.email.toLowerCase() === authEmail.toLowerCase())) {
        setAuthError("Ya existe una cuenta con ese correo. Inicia sesión."); return;
      }
      users.push({ name: authName, email: authEmail, password: authPassword });
      localStorage.setItem("fan_users", JSON.stringify(users));
      finishAuth(authName, authEmail);
    } else {
      const found = users.find(u => u.email.toLowerCase() === authEmail.toLowerCase() && u.password === authPassword);
      if (!found) { setAuthError("Correo o contraseña incorrectos."); return; }
      finishAuth(found.name, found.email);
    }
  };

  const finishAuth = (name: string, email: string) => {
    const u = { name, email };
    setAuthUser(u);
    localStorage.setItem("fan_auth_user", JSON.stringify(u));
    setSubscriberName(name);
    setSubscriberEmail(email);
    setShowAuthModal(false);
    setAuthName(""); setAuthEmail(""); setAuthPassword(""); setAuthError("");
  };

  const handleLogout = () => {
    setAuthUser(null);
    localStorage.removeItem("fan_auth_user");
  };

  // Open Form for Adding Product
  const handleOpenAddForm = () => {
    setEditingProduct(null);
    setFormName("");
    setFormScientificName("");
    setFormDescription("");
    setFormCategory("Semilla/Nuez");
    setFormCharacteristics("");
    setFormSeasonMonths([8, 9, 10]); // Default Almendra
    setFormUses("");
    setFormTown("Concepción");
    setFormLat(40);
    setFormLng(50);
    setFormContacts([]);
    setFormRecipes([]);
    setShowAdminForm(true);
  };

  // Open Form for Editing Product
  const handleOpenEditForm = (prod: Product) => {
    setEditingProduct(prod);
    setFormName(prod.name);
    setFormScientificName(prod.scientificName);
    setFormDescription(prod.description);
    setFormCategory(prod.category);
    setFormCharacteristics(prod.characteristics.join("\n"));
    setFormSeasonMonths(prod.seasonMonths);
    setFormUses(prod.gastronomicUses.join("\n"));
    setFormTown(prod.origin.town);
    setFormLat(prod.origin.lat);
    setFormLng(prod.origin.lng);
    setFormContacts(prod.contacts);
    setFormRecipes(prod.recipes);
    setShowAdminForm(true);
  };

  // Add Contact Helper
  const handleAddContact = () => {
    if (!newContactName || !newContactPhone) return;
    const newContact: Contact = {
      id: "cont-" + Date.now(),
      name: newContactName,
      role: newContactRole,
      type: newContactType,
      phone: newContactPhone,
      location: newContactLocation || formTown
    };
    setFormContacts([...formContacts, newContact]);
    setNewContactName("");
    setNewContactRole("");
    setNewContactPhone("");
    setNewContactLocation("");
  };

  // Remove Contact Helper
  const handleRemoveContact = (id: string) => {
    setFormContacts(formContacts.filter(c => c.id !== id));
  };

  // Add Recipe Helper
  const handleAddRecipe = () => {
    if (!newRecipeTitle || !newRecipeIngredients || !newRecipeInstructions) return;
    const newRec: Recipe = {
      id: "rec-" + Date.now(),
      title: newRecipeTitle,
      description: newRecipeDesc,
      ingredients: newRecipeIngredients.split("\n").filter(Boolean),
      instructions: newRecipeInstructions.split("\n").filter(Boolean),
      servings: newRecipeServings,
      difficulty: newRecipeDifficulty
    };
    setFormRecipes([...formRecipes, newRec]);
    setNewRecipeTitle("");
    setNewRecipeDesc("");
    setNewRecipeIngredients("");
    setNewRecipeInstructions("");
  };

  // Remove Recipe Helper
  const handleRemoveRecipe = (id: string) => {
    setFormRecipes(formRecipes.filter(r => r.id !== id));
  };

  // Toggle Season Month select
  const handleToggleMonth = (mNum: number) => {
    if (formSeasonMonths.includes(mNum)) {
      setFormSeasonMonths(formSeasonMonths.filter(m => m !== mNum));
    } else {
      setFormSeasonMonths([...formSeasonMonths, mNum].sort((a, b) => a - b));
    }
  };

  // Submit Product Form
  const handleSubmitProduct = (e: React.FormEvent) => {
    e.preventDefault();
    if (!formName || !formScientificName || !formDescription) {
      alert("Por favor rellene el nombre, nombre científico y descripción.");
      return;
    }

    const characteristicsArr = formCharacteristics.split("\n").map(s => s.trim()).filter(Boolean);
    const usesArr = formUses.split("\n").map(s => s.trim()).filter(Boolean);

    const productPayload: Product = {
      id: editingProduct ? editingProduct.id : formName.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, ""),
      name: formName,
      scientificName: formScientificName,
      description: formDescription,
      characteristics: characteristicsArr.length > 0 ? characteristicsArr : ["Fruto originario recolectado de manera silvestre."],
      category: formCategory,
      seasonMonths: formSeasonMonths.length > 0 ? formSeasonMonths : [simulatedMonth],
      imageUrl: editingProduct ? editingProduct.imageUrl : `${formName.toLowerCase().split(" ")[0]}_illustration`,
      origin: {
        town: formTown,
        department: "Santa Cruz",
        lat: formLat,
        lng: formLng
      },
      contacts: formContacts,
      gastronomicUses: usesArr.length > 0 ? usesArr : ["Usos culinarios múltiples."],
      recipes: formRecipes
    };

    let nextProductsList = [...products];
    if (editingProduct) {
      nextProductsList = nextProductsList.map(p => p.id === editingProduct.id ? productPayload : p);
    } else {
      nextProductsList.push(productPayload);
    }

    saveProductsList(nextProductsList);
    setSelectedProduct(productPayload);
    setShowAdminForm(false);
    setEditingProduct(null);
  };

  // Delete Product
  const handleDeleteProduct = (id: string) => {
    if (window.confirm("¿Está seguro de eliminar este producto del bosque? Esta acción no se puede deshacer.")) {
      const nextList = products.filter(p => p.id !== id);
      saveProductsList(nextList);
      if (selectedProduct?.id === id) {
        setSelectedProduct(nextList[0] || null);
      }
    }
  };

  // Custom status color resolver
  const getStatusBadge = (status: ProductStatus) => {
    switch (status) {
      case "En Temporada":
        return (
          <span className="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800">
            <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            En Temporada Plena
          </span>
        );
      case "Comienza Pronto":
        return (
          <span className="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-blue-950 text-blue-300 border border-blue-900">
            <span className="w-2 h-2 rounded-full bg-blue-400"></span>
            Comienza Pronto
          </span>
        );
      case "Termina Pronto":
        return (
          <span className="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-amber-950 text-amber-300 border border-amber-800">
            <span className="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            ⚠️ Termina Pronto
          </span>
        );
      case "Fuera de Temporada":
        return (
          <span className="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full bg-slate-900 text-slate-400 border border-slate-800">
            <span className="w-2 h-2 rounded-full bg-slate-600"></span>
            Fuera de Temporada
          </span>
        );
    }
  };

  return (
    <div className="min-h-screen bg-[#F5F3ED] text-stone-850 flex flex-col font-sans selection:bg-[#c5a059]/30 selection:text-[#070b09] antialiased relative overflow-x-hidden">

      {/* Ambient background decoration circles for premium organic look */}
      <div className="absolute top-10 left-10 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none z-0"></div>
      <div className="absolute bottom-20 right-20 w-96 h-96 bg-[#c5a059]/5 rounded-full blur-3xl pointer-events-none z-0"></div>

      {/* Institutional Banner */}
      <div className="bg-[#0e261b] border-b border-emerald-950 text-emerald-100/90 py-3 px-4 text-xs transition-colors">
        <div className="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-3 md:gap-4">
          <div className="flex items-center gap-2.5 overflow-hidden min-w-0">
            <span className="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[#1b4d36] text-[#61e4ad] font-semibold text-[10px] tracking-wide shrink-0 border border-emerald-800/40">
              <Bell className="w-3 h-3 text-[#61e4ad]" /> Alertas Bioclimáticas
            </span>
            <div className="text-[11px] font-medium text-stone-200 tracking-wide truncate min-w-0">
              {currentAlerts.length > 0 ? (
                <span>
                  {currentAlerts[0].message} •
                  <span className="text-[#c5a059] ml-2 underline cursor-pointer hover:text-[#d9b773] font-semibold" onClick={() => {
                    const found = products.find(p => p.id === currentAlerts[0].productId);
                    if (found) {
                      setSelectedProduct(found);
                      setActiveTab("catalog");
                    }
                  }}>Ver Ficha Técnica</span>
                </span>
              ) : (
                "🌿 Conservando la Biodiversidad del Bosque Seco Chiquitano mediante el aprovechamiento forestal no-maderable sostenible."
              )}
            </div>
          </div>
          <div className="flex items-center gap-3 md:shrink-0 min-w-0">
            <span className="text-[10px] text-stone-400 font-medium shrink-0">Cronograma Mensual:</span>
            <div className="flex items-center gap-1 bg-[#091b13] p-0.5 rounded-lg border border-emerald-900/30 overflow-x-auto no-scrollbar">
              {MONTH_NAMES.map((name, idx) => (
                <button
                  key={name}
                  id={`m-ticker-${idx}`}
                  onClick={() => setSimulatedMonth(idx + 1)}
                  className={`px-2 py-0.5 rounded text-[9.5px] font-semibold tracking-tight transition-all cursor-pointer shrink-0 ${simulatedMonth === idx + 1
                    ? "bg-[#c5a059] text-[#070b09]"
                    : "text-stone-400 hover:text-stone-100 hover:bg-[#123626]"
                    }`}
                >
                  {name.substring(0, 3)}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Main Header */}
      <header className="bg-[#fbfcfb]/95 backdrop-blur-md border-b-2 border-[#0f4c3a] sticky top-0 z-40 transition-all shadow-xs">
        <div className="max-w-7xl mx-auto px-4 py-3 sm:px-6 lg:px-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div className="flex items-center gap-3.5 animate-fadeIn shrink-0">
            <Logo className="h-10 sm:h-14 transition-transform hover:scale-[1.02] duration-300 cursor-pointer" />
          </div>

          {/* Main Mode Navigation tabs - Redesigned with organic greens */}
          <nav className="flex items-center gap-1 bg-[#eef5f1] p-1 rounded-xl border border-[#d6e5dc] shadow-inner overflow-x-auto no-scrollbar -mx-1 sm:mx-0">
            <button
              id="tab-home-btn"
              onClick={() => setActiveTab("home")}
              className={`flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer shrink-0 whitespace-nowrap ${activeTab === "home"
                ? "bg-[#0f4c3a] text-white shadow-md font-bold"
                : "text-[#0f4c3a]/80 hover:text-[#0f4c3a] hover:bg-[#e4eedf]/40"
                }`}
            >
              <Home className={`w-3.5 h-3.5 ${activeTab === "home" ? "text-white animate-pulse" : "text-[#0f4c3a]"}`} />
              <span>Inicio</span>
            </button>
            <button
              id="tab-catalog-btn"
              onClick={() => setActiveTab("catalog")}
              className={`flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer shrink-0 whitespace-nowrap ${activeTab === "catalog"
                ? "bg-[#0f4c3a] text-white shadow-md font-bold"
                : "text-[#0f4c3a]/80 hover:text-[#0f4c3a] hover:bg-[#e4eedf]/40"
                }`}
            >
              <Calendar className={`w-3.5 h-3.5 ${activeTab === "catalog" ? "text-white" : "text-[#0f4c3a]"}`} />
              <span>Bio-Calendario</span>
            </button>
            <button
              id="tab-map-btn"
              onClick={() => setActiveTab("map")}
              className={`flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer shrink-0 whitespace-nowrap ${activeTab === "map"
