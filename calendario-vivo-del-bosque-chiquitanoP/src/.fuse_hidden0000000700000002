                      />
                    </div>

                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Nombre Científico *</label>
                      <input
                        type="text"
                        required
                        placeholder="Ej. Dipteryx alata"
                        value={formScientificName}
                        onChange={(e) => setFormScientificName(e.target.value)}
                        className="w-full p-2.5 bg-slate-900 border border-slate-800 rounded-xl text-xs text-slate-200 font-serif italic focus:border-emerald-700 focus:outline-none"
                      />
                    </div>

                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Categoría de Especie *</label>
                      <select
                        value={formCategory}
                        onChange={(e) => setFormCategory(e.target.value as Product["category"])}
