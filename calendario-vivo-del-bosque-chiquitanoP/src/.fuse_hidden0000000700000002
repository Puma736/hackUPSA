                      >
                        {CATEGORIES.map(cat => (
                          <option key={cat} value={cat}>{cat}</option>
                        ))}
                      </select>
                    </div>

                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Descripción del Recurso Forestal *</label>
                      <textarea
                        required
                        rows={3}
                        placeholder="Escribe la descripción de la especie, cómo florece en el bosque, su aporte ecológico..."
                        value={formDescription}
                        onChange={(e) => setFormDescription(e.target.value)}
