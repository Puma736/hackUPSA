                      />
                    </div>

                    <div className="space-y-1">
                      <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Características (una por línea) *</label>
                      <textarea
                        rows={3}
                        placeholder="Ej: Rico en proteínas del bosque...&#10;Textura sumamente aceitosa..."
                        value={formCharacteristics}
                        onChange={(e) => setFormCharacteristics(e.target.value)}
