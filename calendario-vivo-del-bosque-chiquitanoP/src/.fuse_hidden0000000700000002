                              <h6 className="text-[10px] font-bold uppercase text-stone-500 tracking-wider font-mono">Preparación paso a paso:</h6>
                              <ol className="space-y-3.5 pr-2">
                                {recipe.instructions.map((step, idx) => (
                                  <li key={idx} className="text-xs text-stone-700 flex items-start gap-3">
                                    <span className="bg-white border border-stone-200 text-stone-700 font-bold w-5 h-5 rounded-full flex items-center justify-center shrink-0 text-[10px] mt-0.5">
                                      {idx + 1}
                                    </span>
                                    <span className="leading-relaxed font-serif">{step}</span>
                                  </li>
                                ))}
                              </ol>
                            </div>
                          </div>
                        </div>
                      ))
                    )}
                  </div>

                </div>
              ) : (
                <div className="text-center py-20 bg-slate-900/15 border border-slate-800 rounded-3xl flex flex-col items-center justify-center">
                  <Calendar className="w-16 h-16 text-slate-700 stroke-1 mb-3" />
                  <p className="text-sm text-slate-400">Seleccione un producto forestal del catálogo izquierdo para ver su ficha técnica viva.</p>
                </div>
              )}
            </div>

          </div>
        )}

        {/* Tab 2: Mapa de Origen */}
        {activeTab === "map" && (
          <div className="space-y-6">
            <InteractiveMap
              products={products}
              onSelectProduct={(prod) => {
                setSelectedProduct(prod);
                setActiveTab("catalog");
              }}
            />
          </div>
        )}

        {/* Tab 3: Asistente AI Chef Gemini */}
        {activeTab === "chef" && (
          <div className="space-y-6">
            <AiChef products={products} />
          </div>
        )}

        {/* Tab 4: Backoffice / Panel de Administracion */}
        {activeTab === "admin" && (
          <div className="space-y-6 bg-[#0b120f] rounded-3xl border border-emerald-950/45 p-6.5 shadow-xl shadow-black/25">

            {/* Header info bar */}
            <div className="flex flex-col sm:flex-row justify-between sm:items-center gap-4 pb-4 border-b border-emerald-950/30">
              <div>
                <span className="text-[10px] font-black uppercase tracking-widest text-[#c5a059] bg-[#c5a059]/10 px-3.5 py-1 rounded-full border border-[#c5a059]/25 font-mono">
                  Soporte de Monitoreo Bioclimático
                </span>
                <h3 className="text-xl font-black mt-2 text-[#f5f2eb]">Panel Administrativo de la FAN</h3>
                <p className="text-xs text-stone-400 font-serif">
