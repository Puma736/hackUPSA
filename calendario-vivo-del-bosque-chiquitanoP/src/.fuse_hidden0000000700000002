                      />
                    </div>
                  </div>

                  {/* Seasonal and Location info */}
                  <div className="md:col-span-6 space-y-4">
                    <div className="bg-slate-900 p-4 rounded-2xl border border-slate-850">
                      <label className="text-[10px] font-bold text-[#d4af37] uppercase tracking-widest block mb-2">Selecciona meses de temporada *</label>
                      <div className="grid grid-cols-4 gap-1.5">
                        {MONTH_NAMES.map((name, idx) => {
                          const monthNum = idx + 1;
                          const isSelected = formSeasonMonths.includes(monthNum);

                          return (
                            <button
                              key={name}
                              type="button"
                              onClick={() => handleToggleMonth(monthNum)}
                              className={`p-2 rounded text-[10px] font-bold text-center border cursor-pointer transition-all ${isSelected
                                ? "bg-emerald-950 text-emerald-400 border-emerald-700"
                                : "bg-slate-950 text-slate-500 border-slate-900 hover:text-slate-350"
