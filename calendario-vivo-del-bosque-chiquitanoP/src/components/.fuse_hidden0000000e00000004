import React from "react";
import logoUrl from "../../assets/logo_tempofan.svg";

/** TempoFAN brand logo (uploaded SVG). */

export function LogoMark({ className = "" }: { className?: string }) {
  return <img src={logoUrl} alt="TempoFAN" className={className} />;
}

export default function Logo({ className = "" }: { className?: string }) {
  return (
    <img
      src={logoUrl}
      alt="TempoFAN — La temporada correcta, en el momento correcto"
      className={className}
    />
  );
}
