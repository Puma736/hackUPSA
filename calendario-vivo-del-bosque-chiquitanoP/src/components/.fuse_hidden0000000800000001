import { useState } from "react";
import { MapPin, Info, ArrowRight, ShieldCheck, Compass } from "lucide-react";
import { Product } from "../types";

interface InteractiveMapProps {
  products: Product[];
  onSelectProduct: (product: Product) => void;
}

/**
 * Town positions are derived from REAL approximate geographic coordinates of the
 * Chiquitania (Santa Cruz, Bolivia) and projected onto the 0-100 map canvas, so
 * each locality sits in its correct relative place (north = top, east = right).
 */
type Town = { name: string; x: number; y: number; desc: string };

const TOWNS: Town[] = [
  { name: "Concepción", x: 13, y: 16, desc: "Sede del Festival de las Orquídeas, rodeada de serranías altas y densos bosques húmedos secundarios." },
  { name: "San Ignacio de Velasco", x: 45, y: 23, desc: "La capital de la provincia Velasco, rodeada de sabanas inundables, pampas y bosques de almendros." },
  { name: "Lomerío", x: 25, y: 41, desc: "Territorio indígena originario de la etnia Monkoxi, pioneros en manejo forestal comunitario sostenible." },
  { name: "San José de Chiquitos", x: 51, y: 66, desc: "Cuna de la cruceñidad, ubicado al pie de la serranía del parque nacional histórico Santa Cruz la Vieja." },
  { name: "Roboré", x: 78, y: 82, desc: "La perla del Oriente, zona tropical templada con ríos de aguas cristalinas, serranías de Chochís y palmares nativos." },
  { name: "Santiago de Chiquitos", x: 88, y: 73, desc: "Valle místico custodiado por gigantes de piedra y tupidos bosques secos con gran presencia de Copaibos antiguos." }
];

// helper to read a town position
const pos = (n: string) => TOWNS.find(t => t.name === n)!;

export default function InteractiveMap({ products, onSelectProduct }: InteractiveMapProps) {
  const [selectedTown, setSelectedTown] = useState<string | null>("Concepción");
  const [hoveredTown, setHoveredTown] = useState<string | null>(null);

  const currentTownDetails = TOWNS.find(t => t.name === selectedTown);
  const productsFromTown = products.filter(p => p.origin.town === selectedTown);

  // Routes built from the real pin coordinates so the lines connect the dots exactly.
  const c = pos("Concepción"), si = pos("San Ignacio de Velasco"), lo = pos("Lomerío"),
    sj = pos("San José de Chiquitos"), ro = pos("Roboré"), sa = pos("Santiago de Chiquitos");
  const missionRoute = `M ${c.x} ${c.y} L ${lo.x} ${lo.y} L ${sj.x} ${sj.y} L ${ro.x} ${ro.y} L ${sa.x} ${sa.y}`;
  const velascoBranch = `M ${c.x} ${c.y} L ${si.x} ${si.y}`;

  return (
    <div className="bg-white text-stone-800 p-6 rounded-3xl shadow-xs border border-stone-200">
      <div className="mb-5">
        <span className="text-[10px] uppercase tracking-widest text-[#a07c39] font-bold bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
          Exploración de Origen Ecológico
        </span>
        <h3 className="text-xl font-extrabold mt-2 pb-0.5 text-[#0f4c3a]">Mapa de Biodiversidad Chiquitana</h3>
        <p className="text-xs text-stone-550 mt-1">
          Presiona los centros de recolección en el mapa interactivo para ver qué recursos forestales no-maderables genera cada comunidad de la provincia.
        </p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        {/* ===== SVG Map Section ===== */}
        <div className="lg:col-span-7 rounded-2xl p-4 flex flex-col justify-between border border-stone-250/70 relative overflow-hidden min-h-[320px] bg-gradient-to-br from-[#eef6ee] via-[#f4f8f1] to-[#e7f0f4]">

          {/* Compass */}
          <div className="absolute top-3 right-3 z-30 flex flex-col items-center text-[#0f4c3a]/70">
            <Compass className="w-5 h-5" />
            <span className="text-[8px] font-black tracking-widest mt-0.5">N</span>
          </div>

          <div className="w-full relative h-[250px] md:h-[300px]">
            {/* Decorative terrain + routes (stretches with container, same coord space as pins) */}
            <svg viewBox="0 0 100 100" className="absolute inset-0 w-full h-full" preserveAspectRatio="none">
              <defs>
                <linearGradient id="hills" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stopColor="#bfe0b8" stopOpacity="0.55" />
                  <stop offset="100%" stopColor="#bfe0b8" stopOpacity="0.05" />
                </linearGradient>
                <radialGradient id="forest" cx="50%" cy="40%" r="75%">
                  <stop offset="0%" stopColor="#dff0d6" stopOpacity="0.0" />
                  <stop offset="100%" stopColor="#9fce93" stopOpacity="0.25" />
                </radialGradient>
              </defs>

              {/* soft forest wash */}
              <rect x="0" y="0" width="100" height="100" fill="url(#forest)" />

              {/* rolling hills (north serranías) */}
              <path d="M0 24 Q 20 10 42 22 T 100 16 V0 H0 Z" fill="url(#hills)" />
              <path d="M0 86 Q 30 70 60 84 T 100 78 V100 H0 Z" fill="url(#hills)" />

              {/* a winding river */}
              <path d="M -2 55 Q 25 48 40 62 Q 58 78 78 64 Q 90 56 102 66" fill="none"
                stroke="#8fc7e6" strokeWidth="1.4" strokeOpacity="0.55" strokeLinecap="round" />

              {/* faint contour lines */}
              <g stroke="#0f4c3a" strokeOpacity="0.10" strokeWidth="0.4" fill="none">
                <path d="M 8 30 Q 30 22 52 34 T 96 28" />
                <path d="M 4 70 Q 36 62 60 80 T 98 74" strokeDasharray="2 2" />
              </g>

              {/* Mission route (dashed, connects the pins) */}
              <path d={missionRoute} fill="none" stroke="#0f4c3a" strokeOpacity="0.5" strokeWidth="0.9" strokeDasharray="2.5 2.5" strokeLinecap="round" strokeLinejoin="round" />
              <path d={velascoBranch} fill="none" stroke="#a07c39" strokeOpacity="0.55" strokeWidth="0.9" strokeDasharray="2.5 2.5" strokeLinecap="round" />
            </svg>

            {/* Render Town Pins */}
            {TOWNS.map((town) => {
              const isActive = selectedTown === town.name;
              const isHover = hoveredTown === town.name;
              const showLabel = isActive || isHover;
              const hashCount = products.filter(p => p.origin.town === town.name).length;

              return (
                <button
                  key={town.name}
                  id={`map-pin-${town.name.toLowerCase().replace(/\s+/g, "-")}`}
                  onClick={() => setSelectedTown(town.name)}
                  onMouseEnter={() => setHoveredTown(town.name)}
                  onMouseLeave={() => setHoveredTown(null)}
                  className="absolute cursor-pointer transition-all duration-300 group -translate-x-1/2 -translate-y-1/2"
                  style={{ left: `${town.x}%`, top: `${town.y}%`, zIndex: showLabel ? 40 : 10 }}
                >
                  <div className="relative flex flex-col items-center">
                    {/* Ping ring on active */}
                    {isActive && (
                      <span className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 inline-flex h-9 w-9 rounded-full bg-emerald-500/25 animate-ping"></span>
                    )}

                    {/* Pin marker */}
                    <div className={`relative grid place-items-center rounded-full border-2 shadow-md transition-all duration-300 ${isActive
                      ? "w-9 h-9 bg-[#a07c39] text-white border-white scale-100 shadow-amber-900/20"
                      : "w-7 h-7 bg-white text-emerald-700 border-emerald-600/40 hover:bg-emerald-50 hover:scale-110"
                      }`}>
                      <MapPin className={isActive ? "w-4.5 h-4.5" : "w-4 h-4"} />

                      {/* product count badge */}
                      {hashCount > 0 && (
                        <span className="absolute -top-1.5 -right-1.5 bg-[#0f4c3a] text-white text-[8px] font-bold w-3.5 h-3.5 rounded-full grid place-items-center border border-white">
                          {hashCount}
                        </span>
                      )}
                    </div>

                    {/* Label: only on hover/active to avoid clutter */}
                    <span className={`absolute top-full mt-1 left-1/2 -translate-x-1/2 px-2 py-0.5 rounded-md text-[10px] font-semibold whitespace-nowrap shadow-sm transition-all duration-200 ${showLabel ? "opacity-100 translate-y-0" : "opacity-0 -translate-y-1 pointer-events-none"} ${isActive ? "bg-[#0f4c3a] text-white" : "bg-white text-stone-700 border border-stone-200"}`}>
                      {town.name}
                    </span>
                  </div>
                </button>
              );
            })}
          </div>

          <div className="flex items-center justify-between text-[11px] text-stone-600 border-t border-stone-200/80 pt-2 shrink-0 relative z-30">
            <span className="flex items-center gap-1.5 font-bold">
              <span className="w-2.5 h-2.5 bg-[#a07c39] rounded-full inline-block ring-2 ring-amber-200"></span> Localidad Activa
            </span>
            <span className="flex items-center gap-1"><MapPin className="w-3 h-3 text-rose-500" /> Bosque Seco Chiquitano, Bolivia</span>
          </div>
        </div>

        {/* ===== Town Details Section ===== */}
        <div className="lg:col-span-5 flex flex-col justify-between bg-stone-50 p-5 rounded-2xl border border-stone-200/90 shadow-xs">
          <div>
            <div className="flex items-start justify-between border-b border-stone-200 pb-3 mb-3">
              <div>
                <h4 className="font-extrabold text-lg text-[#0f4c3a]">{selectedTown}</h4>
                <p className="text-[11px] text-stone-500 font-sans">Municipio de Origen • Chiquitania</p>
              </div>
              <ShieldCheck className="w-5 h-5 text-emerald-700 shrink-0" />
            </div>

            <p className="text-xs text-stone-700 leading-relaxed italic mb-4 font-serif">
              "{currentTownDetails?.desc}"
            </p>

            <h5 className="text-[10px] font-bold uppercase tracking-wider text-stone-550 block mb-2 font-mono">
              Insumos de este origen:
            </h5>

            {productsFromTown.length === 0 ? (
              <div className="bg-white rounded-xl p-4 text-center border border-stone-200">
                <Info className="w-5 h-5 text-stone-400 mx-auto mb-1" />
                <p className="text-[11px] text-stone-500 font-sans">Ningún producto asignado a esta zona actualmente.</p>
              </div>
            ) : (
              <div className="space-y-2">
                {productsFromTown.map(prod => (
                  <div
                    key={prod.id}
                    id={`map-product-row-${prod.id}`}
                    onClick={() => onSelectProduct(prod)}
                    className="flex items-center justify-between p-2.5 rounded-xl bg-white hover:bg-emerald-50/40 border border-stone-200/70 hover:border-emerald-300 transition-all cursor-pointer group"
                  >
                    <div>
                      <h6 className="text-xs font-semibold text-stone-900 group-hover:text-emerald-800 transition-colors">
                        {prod.name}
                      </h6>
                      <em className="text-[10px] text-stone-500 block font-serif italic">{prod.scientificName}</em>
                    </div>
                    <div className="flex items-center gap-2">
                      <span className="text-[9px] bg-emerald-50 text-emerald-805 px-2 py-0.5 rounded border border-emerald-100 font-bold uppercase tracking-wider">
                        {prod.category}
                      </span>
                      <ArrowRight className="w-3.5 h-3.5 text-stone-400 group-hover:text-emerald-700 group-hover:translate-x-1 duration-200" />
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div className="mt-4 bg-emerald-55/70 rounded-xl p-3.5 border border-emerald-200/50 text-[11px] text-emerald-900 leading-relaxed font-sans">
            🌿 El manejo sostenible de estos productos forestales no maderables (PFNM) genera empleo local consolidado y promueve la conservación activa de los ecosistemas ante el cambio climático.
          </div>
        </div>
      </div>
    </div>
  );
}
